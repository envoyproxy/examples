FROM apache/skywalking-oap-server:11.1.0@sha256:ddf74a9059ce4c2cc22120cb3d36b1edf6bbb0e3316eca3e4dff295dd2ff7ee9

# The 11.1 OAP image dropped curl, which the compose healthcheck uses to probe
# http://localhost:12800/healthcheck; reinstate it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
